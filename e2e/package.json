{
  "name": "blocks-os-e2e",
  "private": true,
  "version": "0.0.1",
  "description": "Playwright end-to-end tests for Blocks OS",
  "scripts": {
    "test": "E2E_FEATURES=all node run-e2e.mjs",
    "test:features": "node run-e2e.mjs",
    "test:auth": "playwright test --project=setup",
    "test:ui": "E2E_FEATURES=all playwright test --ui",
    "test:headed": "E2E_FEATURES=all playwright test --headed",
    "test:debug": "E2E_FEATURES=all playwright test --debug",
    "report": "playwright show-report",
    "codegen": "playwright codegen",
    "lint": "eslint \"**/*.ts\"",
    "lint:fix": "eslint \"**/*.ts\" --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.0.0",
    "dotenv": "^16.4.5",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "prettier": "^3",
    "eslint-config-prettier": "^9"
  }
}
