# Copy this file to `.env.e2e` (gitignored) and fill in real values.

# Base URL of the running Blocks OS app, served on your named domain.
# Requires a hosts entry pointing that domain at 127.0.0.1, e.g.
#   127.0.0.1 dev-os.blocksdevelopers.com
# Without it the tests hit the remote server instead of your machine.
E2E_BASE_URL=https://dev-os.blocksdevelopers.com:5000

# Dev-IAM test account credentials (captcha is disabled on dev).
E2E_USERNAME=
E2E_PASSWORD=

# Optional domain for synthetic test-only addresses (invites, new users).
# Defaults to example.com when unset.
# E2E_TEST_EMAIL_DOMAIN=example.com

# Prefix for newly created projects: "${PROJECT_NAME} ${Date.now()}".
# Defaults to "Test Project" when unset.
# PROJECT_NAME=Test Project

# Reuse an existing console project instead of creating (recommended when slots are limited).
# E2E_REUSE_PROJECT_NAME=my-shared-project
# Legacy alias (same as E2E_REUSE_PROJECT_NAME):
# E2E_PROJECT_NAME=my-shared-project

# Open a project by UUID — skips console card search.
# E2E_PROJECT_ID=

# Set to 1 to keep the project after the run instead of deleting it in teardown.
# E2E_KEEP_PROJECT=1

# Set to 1 to skip auto-starting the app (you manage the server yourself).
# E2E_NO_WEBSERVER=1

# Comma-separated feature ids for `npm run test:features`, or `all`.
# E2E_FEATURES=overview,users

# Pause after each test so the end state is watchable. Defaults to 10000 in
# headed mode and 0 when headless; set a value to override either way.
# E2E_PAUSE_MS=10000

# How often (ms) the suite re-authenticates with a real login between tests,
# working around the app's own broken silent token refresh. Defaults to
# 600000 (10 minutes). Lower it if the target environment's access tokens
# are short-lived enough that 10 minutes still isn't safe.
# E2E_SESSION_REFRESH_INTERVAL_MS=600000
