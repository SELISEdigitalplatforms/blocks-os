{
  "schemaVersion": 5,
  "catalogueVersion": "2026-09-24.1",
  "notes": {
    "model": "A project is the sum of its environments. Each environment is bought on its own and carries its own limit for every meter. There is no project-wide pool, no split across environments and no swapping between them.",
    "unlimited": "-1 means uncapped. On idleStopMinutes it means the environment never idle-stops. 0 means the environment does not include the feature.",
    "scope": "Every meter is environment-scoped. An environment is a tenant with its own Mongo database, so repositories (release.repos) and people (platform.people) belong to the environment, not the project.",
    "kind": "counter = consumed over the period, held in Redis. resource = live objects that exist right now, counted in Mongo. policy = a setting, read from config.",
    "reset": "period = the included allowance returns to 0 at each boundary. never = it is a standing count. none = no usage is stored.",
    "limitSet": "Environments are individual records that reference a shared limit set and may override any meter. iat, uat and pre-prod share the integration set today; changing one means adding an override, and nothing else moves.",
    "freeTier": "dev alone offers a free tier. It is the same environment with a smaller limit set, so buying the dev package upgrades it in place with used as the floor. Top-ups are not available on the free tier.",
    "topUp": "Any meter on any paid environment can be topped up in whole steps. Counter top-ups are bought once and carry across period boundaries; the included allowance is always drained first. Resource top-ups are recurring: they are charged every period while held, and lowering one defers to the period boundary and can never go below used.",
    "topUpCap": "A meter can be topped up to at most maxMultipleOfIncluded times what the environment includes, rounded down to a whole step. prod is uncapped, because there is no larger environment to move to.",
    "billing": "Monthly only. Adding an environment or a top-up mid-period is prorated to the end of the current period and charged immediately. Removing one takes effect at the period boundary with no refund. Nothing ever re-anchors the usage period.",
    "prices": "Prices are not in this file. See price-book.json, which carries one column per market."
  },
  "unlimited": -1,
  "usagePeriod": {
    "days": 30,
    "anchor": "subscribedAtUtc"
  },
  "billing": {
    "cycles": [
      "monthly"
    ],
    "defaultCycle": "monthly",
    "onAdd": "prorateAndChargeNow",
    "onRemove": "atUsagePeriodEnd",
    "refundOnRemove": false,
    "reanchorOnChange": false
  },
  "defaults": {
    "alertAtPercent": [
      80,
      100
    ],
    "packageChange": {
      "upgrade": "immediate",
      "downgrade": "atUsagePeriodEnd",
      "prorate": true,
      "reanchor": false,
      "floor": "used"
    },
    "topUp": {
      "requiresPaidEnvironment": true,
      "maxMultipleOfIncluded": 2,
      "roundDownToWholeStep": true,
      "counterUnitsCarry": true,
      "drainOrder": [
        "allowance",
        "purchased"
      ],
      "resourceUnitsRecurring": true,
      "resourceDecreaseAt": "usagePeriodEnd"
    }
  },
  "aliases": {
    "stage": "stg",
    "staging": "stg",
    "production": "prod"
  },
