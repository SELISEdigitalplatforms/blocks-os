<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Version>1.0.0</Version>
    <PackageId>SeliseBlocks.Secrets</PackageId>
    <Authors>Selise Blocks</Authors>
    <Company>Selise</Company>
    <Description>Secret management for Blocks: metadata and audit in MongoDB, values in Azure Key Vault.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>Blocks, Secrets, KeyVault, SeliseBlocks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- For SecretExceptionFilter, which ships with the package so every host maps the domain
         exceptions to the same status codes. The domain itself stays transport-agnostic. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SeliseBlocks.Genesis.OS" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XUnitTest" />
  </ItemGroup>

</Project>
