<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <Version>4.1.0</Version>
    <PackageId>SeliseBlocks.Secrets.OS</PackageId>
    <Authors>Selise Blocks</Authors>
    <Company>Selise</Company>
    <Description>Secret management for Blocks: metadata and audit in MongoDB on the tenant's own connection, values in Azure Key Vault.</Description>
    <PackageReleaseNotes>The secret store now follows the tenant's database placement: metadata, audit and database-backed values resolve on the connection recorded in the tenant registry instead of always on the main connection. Existing tenants are unaffected, their registry record already names main. An unknown, disabled or unprovisioned tenant now fails instead of reading main. Index creation is ensured once per cluster rather than once per process. SecretStoreContext takes ITenants in place of IBlocksSecret; hosts that resolve it from the container need no change. Key Vault values still live in the one vault the host is configured with, whichever cluster a tenant is on.</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>Blocks, Secrets, KeyVault, SeliseBlocks</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- For SecretExceptionFilter, which ships with the package so every host maps the domain
         exceptions to the same status codes. The domain itself stays transport-agnostic. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SeliseBlocks.Genesis.OS" />
    <PackageReference Include="MongoDB.Driver" />
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="Azure.Security.KeyVault.Secrets" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="XUnitTest" />
  </ItemGroup>

</Project>
