{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SecretManager": {
    "SecretManagerType": "OnPrem",
    "SecretManagerPath": "x"
  },

  "SwaggerOptions": {
    "Version": "v1",
    "Title": "Blocks OS",
    "Description": "Blocks OS API documentation",
    "XmlCommentsFilePath": "Api.xml",
    "EndpointUrl": "v1/swagger.json",
    "EnableBearerAuth": true,
    "ServiceName": "blocks-os"
  },

  // Origins the SPA needs that no FrontendRuntime key describes. Everything else in the
  // CSP is derived from FrontendRuntime, so it follows the environment automatically.
  // Space- or comma-separated; override per environment or via Csp__ExtraConnectSrc.
  "Csp": {
    "ExtraConnectSrc": "https://code.selise.biz",
    "ExtraImgSrc": "https://az-cdn.selise.biz"
  },

  "FrontendRuntime": {
    "BLOCKS_API_BASE_URL": "http://localhost:5000",
    "BLOCKS_X_BLOCKS_KEY": "***REMOVED***",
    "BLOCKS_GOOGLE_SITE_KEY": "***REMOVED***",
    "BLOCKS_CONSTRUCT_URL": "https://dev-construct.blocksdevelopers.com"
  },
  "KbtclIdentifier": ".dev.blocksdevelopers.com",
  "RootTenantId": "***REMOVED***"
}
