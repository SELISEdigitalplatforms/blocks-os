{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "SecretManager": {
    "SecretManagerType": "OnPrem",
    "SecretManagerPath": "x"
  },

  "SwaggerOptions": {
    "Version": "v1",
    "Title": "Blocks OS",
    "Description": "Blocks OS API documentation",
    "XmlCommentsFilePath": "Api.xml",
    "EndpointUrl": "v1/swagger.json",
    "EnableBearerAuth": true,
    "ServiceName": "blocks-os"
  },

  // Validation rules and default values on system schemas (Data Access page). Keep false until IAM,
  // OS, Logic and Release all run Genesis 4.3.4 or later; while false the rule endpoints answer 404.
  "PlatformDataAccess": {
    "RulesEnabled": false,
    // With rules on: also offer warned schemas (User, Role, mail configuration, …) and warned
    // properties (row access lists, template bodies, …). Off: only the risk-free ones.
    "RulesIncludeWarned": false
  }

  // Origins the SPA needs that no FrontendRuntime key describes. Everything else in the
  // CSP is derived from FrontendRuntime, so it follows the environment automatically.
  // Space- or comma-separated; override per environment or via Csp__ExtraConnectSrc.
}
