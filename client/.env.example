# Exposed via `envPrefix: ['BLOCKS_']` in vite.config (access via `import.meta.env.BLOCKS_*`).
# Copy to `.env` and set values. Restart `npm run dev` after changes.
BLOCKS_X_BLOCKS_KEY=
BLOCKS_OIDC_CLIENT_ID=
BLOCKS_GOOGLE_SITE_KEY=
BLOCKS_CONSTRUCT_URL=
BLOCKS_GITHUB_SSO_CLIENT_ID=
BLOCKS_BASE_DOMAIN=
BLOCKS_IAM_BASE_URL=
BLOCKS_IAM_CALLBACK_URL=
BLOCKS_LOCALIZATION_BASE_URL=
BLOCKS_LOCALIZATION_CALLBACK_URL=
BLOCKS_AGENTS_BASE_URL=
BLOCKS_AGENTS_CALLBACK_URL=
BLOCKS_DATA_BASE_URL=
BLOCKS_DATA_CALLBACK_URL=
# Node-side tooling only: the Vite dev server uses this as its API proxy target. The browser
# ignores it and resolves the OS base URL from the origin serving the app (see index.html).
BLOCKS_OS_BASE_URL=
BLOCKS_OS_CALLBACK_URL=
BLOCKS_UTILITIES_BASE_URL=
BLOCKS_UTILITIES_CALLBACK_URL=
BLOCKS_LOGIC_BASE_URL=
BLOCKS_LOGIC_CALLBACK_URL=
BLOCKS_MONITOR_BASE_URL=
BLOCKS_MONITOR_CALLBACK_URL=
BLOCKS_RELEASE_BASE_URL=
BLOCKS_RELEASE_CALLBACK_URL=
BLOCKS_STUDIO_BASE_URL=
BLOCKS_STUDIO_CALLBACK_URL=
BLOCKS_DATA_CLIENT_ID=
BLOCKS_IAM_CLIENT_ID=
BLOCKS_LOCALIZATION_CLIENT_ID=
BLOCKS_AGENTS_CLIENT_ID=
BLOCKS_OS_CLIENT_ID=
BLOCKS_UTILITIES_CLIENT_ID=
BLOCKS_LOGIC_CLIENT_ID=
BLOCKS_RELEASE_CLIENT_ID=
BLOCKS_MONITOR_CLIENT_ID=
BLOCKS_STUDIO_CLIENT_ID=
BLOCKS_ALLOWED_SERVICES=
# Rollbar project "blocks-os". Client token only: it ships in the bundle and is meant to be
# public. Leave blank to keep error reporting off locally.
BLOCKS_ROLLBAR_CLIENT_TOKEN=
BLOCKS_ROLLBAR_ENV=local

# BLOCKS_OS_BASE_URL=http://localhost:5000
# BLOCKS_X_BLOCKS_KEY=***REMOVED***
# BLOCKS_GOOGLE_SITE_KEY=***REMOVED***
# BLOCKS_CONSTRUCT_URL=https://dev-construct.blocksdevelopers.com
